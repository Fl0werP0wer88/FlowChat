{
  "workbench.iconTheme": "material-icon-theme",
  "explorer.autoReveal": true,
  "files.exclude": {
    "**/.DS_Store": true,
    "**/.artifacts": true,
    "**/.dotnet": true,
    "**/.dotnet-cli": true,
    "**/.dotnet-home": true,
    "**/.idea": true,
    "**/.nuget": true,
    "**/.vs": true,
    "**/*.cache": true,
    "**/*.coverage": true,
    "**/*.coveragexml": true,
    "**/*.log": true,
    "**/*.nupkg": true,
    "**/*.rsuser": true,
    "**/*.sln.docstates": true,
    "**/*.sln.iml": true,
    "**/*.snupkg": true,
    "**/*.suo": true,
    "**/*.trx": true,
    "**/*.user": true,
    "**/*.userosscache": true,
    "**/Bin": true,
    "**/bin": true,
    "**/desktop.ini": true,
    "**/dist": true,
    "**/node_modules": true,
    "**/Obj": true,
    "**/obj": true,
    "**/out": true,
    "**/project.fragment.lock.json": true,
    "**/project.lock.json": true,
    "**/secrets.json": true,
    "**/TestResults": true,
    "**/Thumbs.db": true,
    "**/appsettings.*.local.json": true,
    "**/appsettings.Local.json": true,
    "**/artifacts": true,
    ".claude/worktrees": true,
    ".codex-temp": true,
    ".codex/testgen": true,
    ".codex/worktrees": true
  },
  "search.exclude": {
    "**/TestResults": true,
    "**/TestResults/**": true
  },
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "dprint.dprint",
  "dprint.configPath": "${workspaceFolder}/dprint.json",
  "dotnet.unitTests.runSettingsPath": "coverage.runsettings",
  "[csharp]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[javascript]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[typescript]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "statusbar_command.commands": [
  {
    "text": "$(target)",
    "tooltip": "Sync z aktywnym plikiem (.NET)",
    "id": "sbc_sync_dotnet",
    "name": "Sync Active",
    "alignment": "right",
    "priority": 1000,
    "command": "runCommands",
    "arguments": [
      {
        "commands": [
          "workbench.files.action.collapseExplorerFolders",
          "workbench.files.action.collapseExplorerFolders",
          "workbench.files.action.showActiveFileInExplorer"
        ]
      }
    ]
  }
]
}
