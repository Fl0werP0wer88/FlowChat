{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AuthService API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build: AuthService API",
      "program": "${workspaceFolder}/src/FlowChat.AuthService.API/bin/Debug/net10.0/FlowChat.AuthService.API.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/FlowChat.AuthService.API",
      "stopAtEntry": false,
      "console": "internalConsole",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "AuthService API (No Build)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/FlowChat.AuthService.API/bin/Debug/net10.0/FlowChat.AuthService.API.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/FlowChat.AuthService.API",
      "stopAtEntry": false,
      "console": "internalConsole",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "AuthService OutboxPublisher",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build: AuthService OutboxPublisher",
      "program": "${workspaceFolder}/src/Workers/FlowChat.AuthService.OutboxPublisher/bin/Debug/net10.0/FlowChat.AuthService.OutboxPublisher.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Workers/FlowChat.AuthService.OutboxPublisher",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "AuthService OutboxPublisher (No Build)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/Workers/FlowChat.AuthService.OutboxPublisher/bin/Debug/net10.0/FlowChat.AuthService.OutboxPublisher.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Workers/FlowChat.AuthService.OutboxPublisher",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    }
  ],
  "compounds": [
    {
      "name": "AuthService",
        "configurations": [
        "AuthService API",
        "AuthService OutboxPublisher"
      ],
      "stopAll": true
    }
  ]
}
