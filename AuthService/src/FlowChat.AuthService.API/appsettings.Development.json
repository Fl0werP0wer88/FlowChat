{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "Key": "FLOWCHAT_DEVELOPMENT_JWT_KEY_CHANGE_ME_123456789",
    "Issuer": "FlowChat.AuthService",
    "Audience": "FlowChat.Client",
    "ExpiresMinutes": 60
  },
  "OpenTelemetry": {
    "ServiceName": "FlowChat.AuthService.API",
    "Otlp": {
      "Endpoint": "http://localhost:4317",
      "Protocol": "Grpc"
    }
  },
  "ConnectionStrings": {
     "AuthDb": "Host=localhost;Port=5432;Database=flowchat_auth_db;Username=flowchat_app;Password=flowchat_app_pw;"
  },
  "Kafka": {
    "AccountRegisteredProducer": {
      "BootstrapServers": "localhost:9092",
      "Topic": "dev.flowchat.identity.user.v1"
    }
  }
}
