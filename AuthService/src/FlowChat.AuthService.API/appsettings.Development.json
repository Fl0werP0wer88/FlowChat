{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "EmailSettings": {
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "EnableSsl": false,
    "FromEmail": "noreply@flowchat.local",
    "FromName": "FlowChat Auth",
    "Username": "",
    "Password": "",
    "ConfirmationBaseUrl": "https://localhost:7236/api/users/confirm-email"
  },
  "JwtSettings": {
    "Key": "FLOWCHAT_DEVELOPMENT_JWT_KEY_CHANGE_ME_123456789",
    "Issuer": "FlowChat.AuthService",
    "Audience": "FlowChat.Client",
    "ExpiresMinutes": 60
  },
  "ConnectionStrings": {
     "AuthDb": "Host=localhost;Port=5432;Database=flowchat_auth_db;Username=flowchat_app;Password=flowchat_app_pw;"
  },
  "Kafka": {
    "UserCreatedProducer": {
      "BootstrapServers": "localhost:9092",
      "Topic": "dev.flowchat.identity.user.v1"
    },
    "UserEmailVerificationRequestedProducer": {
      "BootstrapServers": "localhost:9092",
      "Topic": "dev.flowchat.identity.user.v1"
    }
  },
  "MassTransit": {
    "Outbox": {
      "QueryDelaySeconds": 3,
      "QueryMessageLimit": 25,
      "MessageDeliveryLimit": 25,
      "ConcurrentDeliveryLimit": 1,
      "MessageDeliveryTimeoutSeconds": 30
    }
  }
}
