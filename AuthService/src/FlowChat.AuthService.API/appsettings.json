{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "EmailSettings": {
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "EnableSsl": true,
    "FromEmail": "noreply@flowchat.local",
    "FromName": "FlowChat Auth",
    "Username": "",
    "Password": "",
    "ConfirmationBaseUrl": "https://localhost:7236/api/users/confirm-email"
  },
  "JwtSettings": {
    "Key": "FLOWCHAT_DEVELOPMENT_JWT_KEY_CHANGE_ME_123456789",
    "Issuer": "FlowChat.AuthService",
    "Audience": "FlowChat.Client",
    "ExpiresMinutes": 60
  },
  "FlowChat": {
    "DropDatabaseOnStartup": false
  },
  "ConnectionStrings": {
    "AuthDb": "Host=postgres-main-db-server.postgres.database.azure.com;Port=5432;Database=flow-chat.auth_db;Username=pgadmin;Password=;SSL Mode=Require;Trust Server Certificate=true"
  },
  "Kafka": {
    "UserCreatedProducer": {
      "BootstrapServers": "localhost:9092",
      "Topic": "dev.flowchat.identity.user.v1"
    },
    "UserEmailVerificationRequestedProducer": {
      "BootstrapServers": "localhost:9092",
      "Topic": "dev.flowchat.identity.user.v1"
    }
  },
  "AllowedHosts": "*"
}
