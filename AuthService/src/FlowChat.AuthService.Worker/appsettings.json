{
  "ConnectionStrings": {
    "AuthDb": "Host=localhost;Port=5432;Database=flowchat_auth_db;Username=flowchat_app;Password=flowchat_app_pw;"
  },
  "OutboxPublisher": {
    "BootstrapServers": "localhost:9092",
    "AllowedTopics": [
      "dev.flowchat.identity.user.v1"
    ],
    "BatchSize": 50,
    "PollIntervalSeconds": 5,
    "RetryBaseDelaySeconds": 5,
    "MaxRetryDelaySeconds": 300
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
