{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Kafka": {
    "UserEmailConfirmedConsumer": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "auth-service",
      "RetryGroupId": "auth-service-retry",
      "Topic": "dev.flowchat.user-profile.user-profile.v1",
      "DeadLetterTopic": "dev.flowchat.user-profile.user-profile.v1.auth-service.dlq",
      "RetryTiers": [
        {
          "Topic": "dev.flowchat.user-profile.user-profile.v1.auth-service.retry",
          "Delay": "00:00:05"
        },
        {
          "Topic": "dev.flowchat.user-profile.user-profile.v1.auth-service.retry.20s",
          "Delay": "00:00:20"
        },
        {
          "Topic": "dev.flowchat.user-profile.user-profile.v1.auth-service.retry.60s",
          "Delay": "00:01:00"
        },
        {
          "Topic": "dev.flowchat.user-profile.user-profile.v1.auth-service.retry.300s",
          "Delay": "00:05:00"
        }
      ],
      "AutoOffsetReset": "Earliest"
    }
  },
  "ConnectionStrings": {
    "AuthDb": "Host=localhost;Port=5432;Database=flowchat_auth_db;Username=flowchat_app;Password=flowchat_app_pw;"
  }
}
