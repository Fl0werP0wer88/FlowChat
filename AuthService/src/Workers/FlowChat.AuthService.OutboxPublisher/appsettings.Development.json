{
  "ConnectionStrings": {
    "AuthDb": "Host=localhost;Port=5432;Database=flowchat_auth_db;Username=flowchat_app;Password=flowchat_app_pw;"
  },
  "OutboxPublisher": {
    "BatchSize": 500,
    "PollInterval": "00:00:00.500",
    "InitialRetryDelay": "00:00:03",
    "MaxRetryDelay": "00:02:00"
  },
  "Kafka": {
    "AccountRegisteredProducer": {
      "BootstrapServers": "localhost:9092",
      "Topic": "dev.flowchat.identity.user.v1"
    },
    "AccountConfirmedProducer": {
      "BootstrapServers": "localhost:9092",
      "Topic": "dev.flowchat.identity.user.v1"
    },
    "PhoneNumberConfirmedProducer": {
      "BootstrapServers": "localhost:9092",
      "Topic": "dev.flowchat.identity.user.v1"
    },
    "RetryOutbox": {
      "BootstrapServers": "localhost:9092",
      "Topics": [
        "dev.flowchat.user-profile.user-profile.v1.auth-service.retry.5s",
        "dev.flowchat.user-profile.user-profile.v1.auth-service.retry.20s",
        "dev.flowchat.user-profile.user-profile.v1.auth-service.retry.60s",
        "dev.flowchat.user-profile.user-profile.v1.auth-service.retry.300s",
        "dev.flowchat.user-profile.user-profile.v1.auth-service.dlq"
      ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Silverback": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "FlowChat.AuthService.OutboxPublisher",
    "Otlp": {
      "Endpoint": "http://localhost:4317",
      "Protocol": "Grpc"
    }
  }
}
