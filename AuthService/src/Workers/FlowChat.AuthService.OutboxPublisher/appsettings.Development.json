{
  "ConnectionStrings": {
    "AuthDb": "Host=localhost;Port=5432;Database=flowchat_auth_db;Username=flowchat_app;Password=flowchat_app_pw;"
  },
  "OutboxPublisher": {
    "BatchSize": 25,
    "PollIntervalSeconds": 3,
    "RetryBaseDelaySeconds": 3,
    "MaxRetryDelaySeconds": 120
  },
  "Kafka": {
    "AccountRegisteredProducer": {
      "BootstrapServers": "localhost:9092",
      "Topic": "dev.flowchat.identity.user.v1"
    },
    "AccountConfirmedProducer": {
      "BootstrapServers": "localhost:9092",
      "Topic": "dev.flowchat.identity.user.v1"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Silverback": "Warning"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "FlowChat.AuthService.OutboxPublisher",
    "Otlp": {
      "Endpoint": "http://localhost:4317",
      "Protocol": "Grpc"
    }
  }
}
