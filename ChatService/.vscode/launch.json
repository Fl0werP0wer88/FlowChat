{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ChatService API",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/FlowChat.ChatService.API/bin/Debug/net10.0/FlowChat.ChatService.API.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/FlowChat.ChatService.API",
      "stopAtEntry": false,
      "console": "internalConsole",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  ]
}
