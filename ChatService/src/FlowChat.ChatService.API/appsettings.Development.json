{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Kafka": {
    "ConversationV2Producer": {
      "BootstrapServers": "localhost:9092",
      "Topic": "dev.flowchat.chat.conversation-projection.v2"
    },
    "ConversationMembershipV2ProjectionProducer": {
      "BootstrapServers": "localhost:9092",
      "Topic": "dev.flowchat.chat.conversation-membership-projection.v2"
    },
    "ConversationParticipantV2Producer": {
      "BootstrapServers": "localhost:9092",
      "Topic": "dev.flowchat.chat.conversation-participant-projection.v2"
    },
    "ChatMessageV2Producer": {
      "BootstrapServers": "localhost:9092",
      "Topic": "dev.flowchat.chat.message.v2"
    }
  },
  "JwtSettings": {
    "Key": "FLOWCHAT_DEVELOPMENT_JWT_KEY_CHANGE_ME_123456789",
    "Issuer": "https://localhost:7236/",
    "Audience": "FlowChat.Client",
    "ExpiresMinutes": 60
  },
  "OpenTelemetry": {
    "ServiceName": "FlowChat.ChatService.API",
    "Otlp": {
      "Endpoint": "http://localhost:4317",
      "Protocol": "Grpc"
    }
  },
  "ConnectionStrings": {
    "ChatDb": "Host=localhost;Port=5432;Database=flowchat_chat_db;Username=flowchat_app;Password=flowchat_app_pw;"
  },
  "FlowChat": {
    "InternalApi": {
      "ApiKey": "dev-chat-internal-key"
    }
  }
}
