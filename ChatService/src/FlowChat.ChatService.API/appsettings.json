{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Kafka": {
    "ChatMessageSentProducer": {
      "BootstrapServers": "",
      "Topic": "dev.flowchat.chat.message.v1"
    },
    "GroupConversationChangedProducer": {
      "BootstrapServers": "",
      "Topic": "dev.flowchat.chat.group-conversation.v1"
    },
    "GroupConversationProjectionProducer": {
      "BootstrapServers": "",
      "Topic": "dev.flowchat.chat.group-conversation-projection.v1"
    }
  },
  "JwtSettings": {
    "Key": "FLOWCHAT_DEVELOPMENT_JWT_KEY_CHANGE_ME_123456789",
    "Issuer": "https://localhost:7236/",
    "Audience": "FlowChat.Client",
    "ExpiresMinutes": 60
  },
  "FlowChat": {
    "InternalApi": {
      "ApiKey": ""
    }
  },
  "AllowedHosts": "*"
}
