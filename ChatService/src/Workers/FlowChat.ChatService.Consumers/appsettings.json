{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Kafka": {
    "UserProfileConsumer": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "chat-service",
      "RetryGroupId": "chat-service-retry",
      "Topic": "dev.flowchat.user-profile.user-profile.v1",
      "RetryTopic": "dev.flowchat.user-profile.user-profile.v1.chat-service.retry",
      "DeadLetterTopic": "dev.flowchat.user-profile.user-profile.v1.chat-service.dlq",
      "MaxRetryCount": 5,
      "RetryBaseDelaySeconds": 5,
      "RetryMaxDelaySeconds": 300,
      "AutoOffsetReset": "Earliest",
      "BatchSize": 100,
      "BatchMaxWaitTimeMilliseconds": 1000
    }
  }
}
