{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "ChatDb": ""
  },
  "OutboxPublisher": {
    "BatchSize": 500,
    "PollInterval": "00:00:00.500",
    "InitialRetryDelay": "00:00:03",
    "MaxRetryDelay": "00:02:00"
  },
  "Kafka": {
    "ConversationV2Producer": {
      "BootstrapServers": "",
      "Topic": "dev.flowchat.chat.conversation-projection.v2"
    },
    "ConversationMembershipV2ProjectionProducer": {
      "BootstrapServers": "",
      "Topic": "dev.flowchat.chat.conversation-membership-projection.v2"
    },
    "ConversationParticipantV2Producer": {
      "BootstrapServers": "",
      "Topic": "dev.flowchat.chat.conversation-participant-projection.v2"
    },
    "ChatMessageV2Producer": {
      "BootstrapServers": "",
      "Topic": "dev.flowchat.chat.message.v2"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "FlowChat.ChatService.OutboxPublisher"
  }
}
