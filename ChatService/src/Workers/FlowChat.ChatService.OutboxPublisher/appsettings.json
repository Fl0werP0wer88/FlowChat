{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "ChatDb": ""
  },
  "OutboxPublisher": {
    "BatchSize": 25,
    "PollIntervalSeconds": 3,
    "RetryBaseDelaySeconds": 3,
    "MaxRetryDelaySeconds": 120
  },
  "Kafka": {
    "ChatMessageSentProducer": {
      "BootstrapServers": "",
      "Topic": "dev.flowchat.chat.message.v1"
    },
    "GroupConversationChangedProducer": {
      "BootstrapServers": "",
      "Topic": "dev.flowchat.chat.group-conversation.v1"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "FlowChat.ChatService.OutboxPublisher"
  }
}
