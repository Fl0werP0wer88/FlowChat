  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "build-flowchat-backend",
        "type": "process",
        "command": "dotnet",
        "args": [
          "build",
          "${workspaceFolder:FlowChat}/FlowChat.slnx"
        ],
        "group": "build",
        "problemMatcher": "$msCompile",
        "presentation": {
          "reveal": "always",
          "panel": "shared",
          "clear": true
        }
      },
      {
        "label": "build-reactclient",
        "type": "process",
        "command": "npm.cmd",
        "args": [
          "run",
          "build"
        ],
        "options": {
          "cwd": "${workspaceFolder:ReactClient}"
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "shared",
          "clear": true
        }
      },
      {
        "label": "build-flowchat",
        "dependsOn": [
          "build-flowchat-backend",
          "build-reactclient"
        ],
        "dependsOrder": "sequence",
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "presentation": {
          "reveal": "always",
          "panel": "shared",
          "clear": true
        }
      }
    ]
  },
