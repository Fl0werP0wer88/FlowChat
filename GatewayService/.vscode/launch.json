{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GatewayService API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-gateway-service",
      "program": "${workspaceFolder}/src/FlowChat.GatewayService.API/bin/Debug/net10.0/FlowChat.GatewayService.API.dll",
      "cwd": "${workspaceFolder}/src/FlowChat.GatewayService.API",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    },
    {
      "name": "GatewayService API (No Build)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/FlowChat.GatewayService.API/bin/Debug/net10.0/FlowChat.GatewayService.API.dll",
      "cwd": "${workspaceFolder}/src/FlowChat.GatewayService.API",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
