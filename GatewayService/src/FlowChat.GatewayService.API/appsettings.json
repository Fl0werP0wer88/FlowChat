{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ApiUrl": "https://localhost:5000",
  "BlazorUrl": "https://localhost:5010",
  "JwtSettings": {
    "Key": "FLOWCHAT_DEVELOPMENT_JWT_KEY_CHANGE_ME_123456789",
    "Issuer": "FlowChat.AuthService",
    "Audience": "FlowChat.Client",
    "ExpiresMinutes": 60
  },
  "SwaggerAggregation": {
    "Sources": [
      {
        "Name": "AuthService",
        "SwaggerUrl": "http://localhost:5234/swagger/v1/swagger.json",
        "GatewayPrefix": "/auth"
      },
      {
        "Name": "ChatService",
        "SwaggerUrl": "http://localhost:5117/swagger/v1/swagger.json",
        "GatewayPrefix": "/chat"
      },
      {
        "Name": "UserProfileService",
        "SwaggerUrl": "http://localhost:5054/swagger/v1/swagger.json",
        "GatewayPrefix": "/user-profile"
      },
      {
        "Name": "NotificationService",
        "SwaggerUrl": "http://localhost:5206/swagger/v1/swagger.json",
        "GatewayPrefix": "/notification"
      },
      {
        "Name": "SocialGraphService",
        "SwaggerUrl": "http://localhost:5094/swagger/v1/swagger.json",
        "GatewayPrefix": "/social-graph"
      }
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth-users-create": {
        "ClusterId": "auth-service",
        "Match": {
          "Path": "/api/users",
          "Methods": [ "POST" ]
        }
      },
      "auth-users-login": {
        "ClusterId": "auth-service",
        "Match": {
          "Path": "/api/users/login",
          "Methods": [ "POST" ]
        }
      },
      "auth-users-confirm-email": {
        "ClusterId": "auth-service",
        "Match": {
          "Path": "/api/users/confirm-email",
          "Methods": [ "GET" ]
        }
      },
      "user-profile-get-by-id": {
        "ClusterId": "user-profile-service",
        "AuthorizationPolicy": "gateway-authenticated",
        "Match": {
          "Path": "/api/userprofiles/{userId}",
          "Methods": [ "GET" ]
        }
      },
      "notification-get": {
        "ClusterId": "notification-service",
        "AuthorizationPolicy": "gateway-authenticated",
        "Match": {
          "Path": "/api/notifications",
          "Methods": [ "GET" ]
        }
      },
      "social-contacts-get-for-user": {
        "ClusterId": "social-graph-service",
        "AuthorizationPolicy": "gateway-authenticated",
        "Match": {
          "Path": "/api/contacts/{userId}",
          "Methods": [ "GET" ]
        }
      },
      "social-invitations-send": {
        "ClusterId": "social-graph-service",
        "AuthorizationPolicy": "gateway-authenticated",
        "Match": {
          "Path": "/api/invitations",
          "Methods": [ "POST" ]
        }
      },
      "chat-root": {
        "ClusterId": "chat-service",
        "Match": {
          "Path": "/",
          "Methods": [ "GET" ]
        }
      },
      "auth-catch-all": {
        "Order": 100,
        "ClusterId": "auth-service",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/auth" }
        ]
      },
      "chat-catch-all": {
        "Order": 100,
        "ClusterId": "chat-service",
        "AuthorizationPolicy": "gateway-authenticated",
        "Match": {
          "Path": "/chat/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/chat" }
        ]
      },
      "user-profile-catch-all": {
        "Order": 100,
        "ClusterId": "user-profile-service",
        "AuthorizationPolicy": "gateway-authenticated",
        "Match": {
          "Path": "/user-profile/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/user-profile" }
        ]
      },
      "notification-catch-all": {
        "Order": 100,
        "ClusterId": "notification-service",
        "AuthorizationPolicy": "gateway-authenticated",
        "Match": {
          "Path": "/notification/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/notification" }
        ]
      },
      "social-graph-catch-all": {
        "Order": 100,
        "ClusterId": "social-graph-service",
        "AuthorizationPolicy": "gateway-authenticated",
        "Match": {
          "Path": "/social-graph/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/social-graph" }
        ]
      },
      "realtime-catch-all": {
        "Order": 100,
        "ClusterId": "realtime-service",
        "AuthorizationPolicy": "gateway-authenticated",
        "Match": {
          "Path": "/realtime/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/realtime" }
        ]
      }
    },
    "Clusters": {
      "auth-service": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5234/"
          }
        }
      },
      "chat-service": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5117/"
          }
        }
      },
      "user-profile-service": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5054/"
          }
        }
      },
      "notification-service": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5206/"
          }
        }
      },
      "social-graph-service": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5094/"
          }
        }
      },
      "realtime-service": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5215/"
          }
        }
      }
    }
  }
}
