{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "JwtSettings": {
    "Key": "FLOWCHAT_DEVELOPMENT_JWT_KEY_CHANGE_ME_123456789",
    "Issuer": "https://localhost:7236/",
    "Audience": "FlowChat.Client"
  },
  "GatewayClient": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "GatewayCatalog": {
    "Routes": [
      {
        "Name": "Auth API",
        "PublicPath": "/api/users/{**catch-all}",
        "ClusterId": "auth-service",
        "RequiresAuthentication": false
      },
      {
        "Name": "Chat API",
        "PublicPath": "/api/chat/{**catch-all}",
        "ClusterId": "chat-service",
        "RequiresAuthentication": true
      },
      {
        "Name": "Conversations API",
        "PublicPath": "/api/conversations/{**catch-all}",
        "ClusterId": "chat-service",
        "RequiresAuthentication": true
      },
      {
        "Name": "User Profile API",
        "PublicPath": "/api/userprofiles/{**catch-all}",
        "ClusterId": "user-profile-service",
        "RequiresAuthentication": true
      },
      {
        "Name": "User Profile Email Verification Confirmation",
        "PublicPath": "/api/userprofiles/email-verification/confirm",
        "ClusterId": "user-profile-service",
        "RequiresAuthentication": false
      },
      {
        "Name": "Social Graph API",
        "PublicPath": "/api/contacts/{**catch-all}",
        "ClusterId": "social-graph-service",
        "RequiresAuthentication": true
      },
      {
        "Name": "Presence API",
        "PublicPath": "/api/presence/{**catch-all}",
        "ClusterId": "presence-service",
        "RequiresAuthentication": true
      },
      {
        "Name": "Realtime Hub",
        "PublicPath": "/hubs/chat",
        "ClusterId": "realtime-service",
        "RequiresAuthentication": true
      },
      {
        "Name": "Realtime Hub Negotiation",
        "PublicPath": "/hubs/chat/{**catch-all}",
        "ClusterId": "realtime-service",
        "RequiresAuthentication": true
      }
    ]
  },
  "GatewayServices": {
    "ChatServiceBaseUrl": "https://localhost:7254",
    "ChatServiceInternalApiKey": "dev-chat-internal-key",
    "PresenceServiceBaseUrl": "https://localhost:7198",
    "PresenceServiceInternalApiKey": "FLOWCHAT_DEVELOPMENT_INTERNAL_API_KEY_CHANGE_ME"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-users-route": {
        "ClusterId": "auth-service",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "chat-route": {
        "ClusterId": "chat-service",
        "AuthorizationPolicy": "GatewayAuthenticated",
        "Match": {
          "Path": "/api/chat/{**catch-all}"
        }
      },
      "conversations-route": {
        "ClusterId": "chat-service",
        "AuthorizationPolicy": "GatewayAuthenticated",
        "Match": {
          "Path": "/api/conversations/{**catch-all}"
        }
      },
      "user-profile-route": {
        "ClusterId": "user-profile-service",
        "AuthorizationPolicy": "GatewayAuthenticated",
        "Match": {
          "Path": "/api/userprofiles/{**catch-all}"
        }
      },
      "user-profile-email-verification-confirm-route": {
        "ClusterId": "user-profile-service",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Methods": [ "POST" ],
          "Path": "/api/userprofiles/email-verification/confirm"
        }
      },
      "social-graph-route": {
        "ClusterId": "social-graph-service",
        "AuthorizationPolicy": "GatewayAuthenticated",
        "Match": {
          "Path": "/api/contacts/{**catch-all}"
        }
      },
      "presence-route": {
        "ClusterId": "presence-service",
        "AuthorizationPolicy": "GatewayAuthenticated",
        "Match": {
          "Path": "/api/presence/{**catch-all}"
        }
      },
      "realtime-hub-route": {
        "ClusterId": "realtime-service",
        "AuthorizationPolicy": "GatewayAuthenticated",
        "Match": {
          "Path": "/hubs/chat"
        }
      },
      "realtime-hub-subroute": {
        "ClusterId": "realtime-service",
        "AuthorizationPolicy": "GatewayAuthenticated",
        "Match": {
          "Path": "/hubs/chat/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-service": {
        "Destinations": {
          "primary": {
            "Address": "https://localhost:7236/"
          }
        }
      },
      "chat-service": {
        "Destinations": {
          "primary": {
            "Address": "https://localhost:7254/"
          }
        }
      },
      "user-profile-service": {
        "Destinations": {
          "primary": {
            "Address": "https://localhost:7148/"
          }
        }
      },
      "social-graph-service": {
        "Destinations": {
          "primary": {
            "Address": "https://localhost:7194/"
          }
        }
      },
      "notification-service": {
        "Destinations": {
          "primary": {
            "Address": "https://localhost:7206/"
          }
        }
      },
      "presence-service": {
        "Destinations": {
          "primary": {
            "Address": "https://localhost:7198/"
          }
        }
      },
      "realtime-service": {
        "Destinations": {
          "primary": {
            "Address": "https://localhost:7215/"
          }
        }
      }
    }
  }
}
