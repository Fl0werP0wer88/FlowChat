{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "HarnessDb": "Host=localhost;Port=5432;Database=flowchat_harness_db;Username=flowchat_app;Password=flowchat_app_pw;"
  },
  "Kafka": {
    "ProjectionConsumer": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "harness-projection",
      "RetryGroupId": "harness-projection-retry",
      "Topic": "test.flowchat.harness.projection.events",
      "RetryTopic": "test.flowchat.harness.projection.events.retry",
      "DeadLetterTopic": "test.flowchat.harness.projection.events.dlq",
      "MaxRetryCount": 3,
      "RetryBaseDelaySeconds": 1,
      "RetryMaxDelaySeconds": 5,
      "AutoOffsetReset": "Earliest",
      "BatchSize": 100,
      "BatchMaxWaitTimeMilliseconds": 1000
    },
    "RetryPipelineConsumer": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "harness-tiered-retry",
      "RetryGroupId": "harness-tiered-retry-tiers",
      "Topic": "test.flowchat.harness.retry.events",
      "DeadLetterTopic": "test.flowchat.harness.retry.events.dlq",
      "RetryTiers": [
        {
          "Topic": "test.flowchat.harness.retry.events.retry",
          "Delay": "00:00:05"
        },
        {
          "Topic": "test.flowchat.harness.retry.events.retry.20s",
          "Delay": "00:00:20"
        },
        {
          "Topic": "test.flowchat.harness.retry.events.retry.60s",
          "Delay": "00:01:00"
        },
        {
          "Topic": "test.flowchat.harness.retry.events.retry.300s",
          "Delay": "00:05:00"
        }
      ],
      "AutoOffsetReset": "Earliest"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "FlowChat.HarnessService.Consumers",
    "Otlp": {
      "Endpoint": "http://localhost:4317",
      "Protocol": "Grpc"
    }
  }
}
