{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "HarnessApi": {
    "BaseUrl": "https://localhost:7300",
    "ApiKey": "FLOWCHAT_DEVELOPMENT_INTERNAL_API_KEY_CHANGE_ME"
  },
  "Kafka": {
    "ProjectionConsumer": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "harness-projection",
      "RetryGroupId": "harness-projection-retry",
      "Topic": "test.flowchat.harness.projection.events",
      "RetryTopic": "test.flowchat.harness.projection.events.retry",
      "DeadLetterTopic": "test.flowchat.harness.projection.events.dlq",
      "MaxRetryCount": 3,
      "RetryBaseDelaySeconds": 1,
      "RetryMaxDelaySeconds": 5,
      "AutoOffsetReset": "Earliest",
      "BatchSize": 100,
      "BatchMaxWaitTimeMilliseconds": 1000
    }
  },
  "OpenTelemetry": {
    "ServiceName": "FlowChat.HarnessService.Consumers",
    "Otlp": {
      "Endpoint": "http://localhost:4317",
      "Protocol": "Grpc"
    }
  }
}
