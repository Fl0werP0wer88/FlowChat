{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "NotificationApi": {
    "BaseUrl": "https://localhost:7206",
    "ApiKey": "dev-notification-internal-key"
  },
  "Kafka": {
    "UserEmailVerificationRequestedConsumer": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "notification-service",
      "RetryGroupId": "notification-service-retry",
      "Topic": "dev.flowchat.notification.email.v1",
      "RetryTopic": "dev.flowchat.notification.email.v1.notification-service.retry",
      "DeadLetterTopic": "dev.flowchat.notification.email.v1.notification-service.dlq",
      "MaxRetryCount": 5,
      "RetryBaseDelaySeconds": 5,
      "RetryMaxDelaySeconds": 300,
      "AutoOffsetReset": "Earliest"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "FlowChat.NotificationService.Consumers",
    "Otlp": {
      "Endpoint": "http://localhost:4317",
      "Protocol": "Grpc"
    }
  }
}
