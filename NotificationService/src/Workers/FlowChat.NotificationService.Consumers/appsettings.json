{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "NotificationApi": {
    "BaseUrl": "https://localhost:7206",
    "ApiKey": ""
  },
  "Kafka": {
    "UserEmailVerificationRequestedConsumer": {
      "BootstrapServers": "",
      "GroupId": "notification-service",
      "Topic": "dev.flowchat.notification.email.v1",
      "RetryTopic": "dev.flowchat.notification.email.v1.retry",
      "DeadLetterTopic": "dev.flowchat.notification.email.v1.dlq",
      "MaxRetryCount": 5,
      "RetryBaseDelaySeconds": 5,
      "RetryMaxDelaySeconds": 300,
      "AutoOffsetReset": "Earliest"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "FlowChat.NotificationService.Consumers"
  }
}
