{
  "ConnectionStrings": {
    "NotificationDb": "Host=localhost;Port=5432;Database=flowchat_notification_db;Username=flowchat_app;Password=flowchat_app_pw;"
  },
  "OutboxPublisher": {
    "BatchSize": 500,
    "PollInterval": "00:00:00.500",
    "InitialRetryDelay": "00:00:03",
    "MaxRetryDelay": "00:02:00"
  },
  "Kafka": {
    "RetryOutbox": {
      "BootstrapServers": "localhost:9092",
      "Topics": [
        "dev.flowchat.notification.email.v1.notification-service.retry",
        "dev.flowchat.notification.email.v1.notification-service.retry.20s",
        "dev.flowchat.notification.email.v1.notification-service.retry.60s",
        "dev.flowchat.notification.email.v1.notification-service.retry.300s",
        "dev.flowchat.notification.email.v1.notification-service.dlq"
      ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Silverback": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "FlowChat.NotificationService.OutboxPublisher",
    "Otlp": {
      "Endpoint": "http://localhost:4317",
      "Protocol": "Grpc"
    }
  }
}
