{
  "ConnectionStrings": {
    "NotificationDb": ""
  },
  "OutboxPublisher": {
    "BatchSize": 25,
    "PollIntervalSeconds": 3,
    "RetryBaseDelaySeconds": 3,
    "MaxRetryDelaySeconds": 120
  },
  "Kafka": {
    "RetryOutbox": {
      "BootstrapServers": "localhost:9092",
      "Topics": [
        "dev.flowchat.notification.email.v1.notification-service.retry",
        "dev.flowchat.notification.email.v1.notification-service.retry.20s",
        "dev.flowchat.notification.email.v1.notification-service.retry.60s",
        "dev.flowchat.notification.email.v1.notification-service.retry.300s",
        "dev.flowchat.notification.email.v1.notification-service.dlq"
      ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Silverback": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "FlowChat.NotificationService.OutboxPublisher"
  }
}
