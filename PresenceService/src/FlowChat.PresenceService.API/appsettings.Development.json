{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "JwtSettings": {
    "Key": "FLOWCHAT_DEVELOPMENT_JWT_KEY_CHANGE_ME_123456789",
    "Issuer": "https://localhost:7236/",
    "Audience": "FlowChat.Client"
  },
  "FlowChat": {
    "InternalApi": {
      "ApiKey": "FLOWCHAT_DEVELOPMENT_INTERNAL_API_KEY_CHANGE_ME"
    }
  },
  "ConnectionStrings": {
    "PresenceDb": "Host=localhost;Port=5432;Database=flowchat_presence_db;Username=flowchat_app;Password=flowchat_app_pw;",
    "Redis": "localhost:6379,user=default,password=flowchat_redis_pw"
  },
  "PresenceStatus": {
    "KeyPrefix": "flowchat:presence"
  },
  "Kafka": {
    "PresenceStatusChangedProducer": {
      "BootstrapServers": "localhost:9092",
      "Topic": "dev.flowchat.presence.presence"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "FlowChat.PresenceService.API",
    "Otlp": {
      "Endpoint": "http://localhost:4317",
      "Protocol": "Grpc"
    }
  }
}
