{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "PresenceApi": {
    "BaseUrl": "https://localhost:7198",
    "ApiKey": "dev-presence-internal-key"
  },
  "Kafka": {
    "ContactAddedConsumer": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "presence-service",
      "RetryGroupId": "presence-service-contact-added-retry",
      "Topic": "dev.flowchat.social-graph.contact-added.v1",
      "RetryTopic": "dev.flowchat.social-graph.contact-added.v1.retry",
      "DeadLetterTopic": "dev.flowchat.social-graph.contact-added.v1.dlq",
      "MaxRetryCount": 5,
      "RetryBaseDelaySeconds": 5,
      "RetryMaxDelaySeconds": 300,
      "AutoOffsetReset": "Earliest"
    },
    "ContactDeletedConsumer": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "presence-service",
      "RetryGroupId": "presence-service-contact-deleted-retry",
      "Topic": "dev.flowchat.social-graph.contact-deleted.v1",
      "RetryTopic": "dev.flowchat.social-graph.contact-deleted.v1.retry",
      "DeadLetterTopic": "dev.flowchat.social-graph.contact-deleted.v1.dlq",
      "MaxRetryCount": 5,
      "RetryBaseDelaySeconds": 5,
      "RetryMaxDelaySeconds": 300,
      "AutoOffsetReset": "Earliest"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "FlowChat.PresenceService.Consumers",
    "Otlp": {
      "Endpoint": "http://localhost:4317",
      "Protocol": "Grpc"
    }
  }
}
