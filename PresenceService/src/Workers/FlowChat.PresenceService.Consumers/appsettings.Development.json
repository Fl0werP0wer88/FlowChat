{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "PresenceApi": {
    "BaseUrl": "https://localhost:7198",
    "ApiKey": "dev-presence-internal-key"
  },
  "Kafka": {
    "SocialGraphContactConsumer": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "presence-service",
      "RetryGroupId": "presence-service-social-graph-contact-retry",
      "Topic": "dev.flowchat.social-graph.contact",
      "RetryTopic": "dev.flowchat.social-graph.contact.retry",
      "DeadLetterTopic": "dev.flowchat.social-graph.contact.dlq",
      "MaxRetryCount": 5,
      "RetryBaseDelaySeconds": 5,
      "RetryMaxDelaySeconds": 300,
      "AutoOffsetReset": "Earliest"
    },
    "RealtimeConnectionConsumer": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "presence-service-realtime-connection",
      "RetryGroupId": "presence-service-realtime-connection-retry",
      "Topic": "dev.flowchat.realtime.connection.v1",
      "RetryTopic": "dev.flowchat.realtime.connection.v1.retry",
      "DeadLetterTopic": "dev.flowchat.realtime.connection.v1.dlq",
      "MaxRetryCount": 5,
      "RetryBaseDelaySeconds": 5,
      "RetryMaxDelaySeconds": 300,
      "AutoOffsetReset": "Earliest"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "FlowChat.PresenceService.Consumers",
    "Otlp": {
      "Endpoint": "http://localhost:4317",
      "Protocol": "Grpc"
    }
  }
}
