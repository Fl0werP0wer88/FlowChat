{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "PresenceDb": "Host=localhost;Port=5432;Database=flowchat_presence_db;Username=flowchat_app;Password=flowchat_app_pw;"
  },
  "Kafka": {
    "DuetConversationContactConsumer": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "presence-service",
      "RetryGroupId": "presence-service-duet-conversation-contact-retry",
      "Topic": "dev.flowchat.chat.duet-conversation-projection.v1",
      "RetryTopic": "dev.flowchat.chat.duet-conversation-projection.v1.presence-service.retry",
      "DeadLetterTopic": "dev.flowchat.chat.duet-conversation-projection.v1.presence-service.dlq",
      "MaxRetryCount": 5,
      "RetryBaseDelaySeconds": 5,
      "RetryMaxDelaySeconds": 300,
      "AutoOffsetReset": "Earliest",
      "BatchSize": 100,
      "BatchMaxWaitTimeMilliseconds": 1000
    }
  },
  "OpenTelemetry": {
    "ServiceName": "FlowChat.PresenceService.Consumers",
    "Otlp": {
      "Endpoint": "http://localhost:4317",
      "Protocol": "Grpc"
    }
  }
}
