{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Kafka": {
    "SocialGraphContactConsumer": {
      "BootstrapServers": "",
      "GroupId": "presence-service",
      "RetryGroupId": "presence-service-social-graph-contact-retry",
