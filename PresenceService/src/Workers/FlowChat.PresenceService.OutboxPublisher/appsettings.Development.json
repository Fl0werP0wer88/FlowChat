{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "PresenceDb": "Host=localhost;Port=5432;Database=flowchat_presence_db;Username=flowchat_app;Password=flowchat_app_pw;"
  },
  "OutboxPublisher": {
    "BatchSize": 25,
    "PollIntervalSeconds": 3,
    "RetryBaseDelaySeconds": 3,
    "MaxRetryDelaySeconds": 120
  },
  "Kafka": {
    "PresenceStatusChangedProducer": {
      "BootstrapServers": "localhost:9092",
      "Topic": "dev.flowchat.presence.presence-status-changed.v1"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "FlowChat.PresenceService.OutboxPublisher",
    "Otlp": {
      "Endpoint": "http://localhost:4317",
      "Protocol": "Grpc"
    }
  }
}
