{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "PresenceDb": "Host=localhost;Port=5432;Database=flowchat_presence_db;Username=flowchat_app;Password=flowchat_app_pw;"
  },
  "OutboxPublisher": {
    "BatchSize": 500,
    "PollInterval": "00:00:00.500",
    "InitialRetryDelay": "00:00:03",
    "MaxRetryDelay": "00:02:00"
  },
  "Kafka": {
    "PresenceStatusChangedProducer": {
      "BootstrapServers": "localhost:9092",
      "Topic": "dev.flowchat.presence.presence"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "FlowChat.PresenceService.OutboxPublisher",
    "Otlp": {
      "Endpoint": "http://localhost:4317",
      "Protocol": "Grpc"
    }
  }
}
