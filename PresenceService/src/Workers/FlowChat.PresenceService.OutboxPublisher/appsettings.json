{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "PresenceDb": ""
  },
  "OutboxPublisher": {
    "BatchSize": 25,
    "PollIntervalSeconds": 3,
    "RetryBaseDelaySeconds": 3,
    "MaxRetryDelaySeconds": 120
  },
  "Kafka": {
    "PresenceStatusChangedProducer": {
      "BootstrapServers": "",
      "Topic": "dev.flowchat.presence.presence"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "FlowChat.PresenceService.OutboxPublisher"
  }
}
