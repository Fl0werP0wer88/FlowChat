{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "PresenceDb": ""
  },
  "OutboxPublisher": {
    "BatchSize": 500,
    "PollInterval": "00:00:00.500",
    "InitialRetryDelay": "00:00:03",
    "MaxRetryDelay": "00:02:00"
  },
  "Kafka": {
    "PresenceStatusChangedProducer": {
      "BootstrapServers": "",
      "Topic": "dev.flowchat.presence.presence"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "FlowChat.PresenceService.OutboxPublisher"
  }
}
