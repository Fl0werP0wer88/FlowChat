{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev: ReactClientV2",
      "type": "process",
      "command": "npm.cmd",
      "args": ["run", "dev"],
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "a^",
          "message": 0
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "http://localhost:5173/?"
        }
      }
    }
  ]
}
