{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "RealtimeService API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build: RealtimeService API",
      "program": "${workspaceFolder}/src/FlowChat.RealtimeService.API/bin/Debug/net10.0/FlowChat.RealtimeService.API.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/FlowChat.RealtimeService.API",
      "stopAtEntry": false,
      "console": "internalConsole",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "RealtimeService API (No Build)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/FlowChat.RealtimeService.API/bin/Debug/net10.0/FlowChat.RealtimeService.API.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/FlowChat.RealtimeService.API",
      "stopAtEntry": false,
      "console": "internalConsole",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "RealtimeService Worker",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build: RealtimeService Worker",
      "program": "${workspaceFolder}/src/FlowChat.RealtimeService.Worker/bin/Debug/net10.0/FlowChat.RealtimeService.Worker.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/FlowChat.RealtimeService.Worker",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "RealtimeService Worker (No Build)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/FlowChat.RealtimeService.Worker/bin/Debug/net10.0/FlowChat.RealtimeService.Worker.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/FlowChat.RealtimeService.Worker",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    }
  ],
  "compounds": [
    {
      "name": "RealtimeService",
      "configurations": [
        "RealtimeService API",
        "RealtimeService Worker"
      ],
      "stopAll": true
    }
  ]
}
