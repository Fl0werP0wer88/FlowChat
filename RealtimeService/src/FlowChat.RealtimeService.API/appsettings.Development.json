{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "FlowChat.RealtimeService.API",
    "Otlp": {
      "Endpoint": "http://localhost:4317",
      "Protocol": "Grpc"
    }
  },
  "Kafka": {
    "RealtimeConnectionProducer": {
      "BootstrapServers": "localhost:9092",
      "Topic": "dev.flowchat.realtime.connection.v1"
    }
  }
}
