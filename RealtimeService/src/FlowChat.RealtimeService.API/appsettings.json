{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ApiUrl": "https://localhost:5000",
  "BlazorUrl": "https://localhost:5010",
  "JwtSettings": {
    "Key": "FLOWCHAT_DEVELOPMENT_JWT_KEY_CHANGE_ME_123456789",
    "Issuer": "https://localhost:7236/",
    "Audience": "FlowChat.Client"
  },
  "FlowChat": {
    "InternalApi": {
      "ApiKey": "FLOWCHAT_DEVELOPMENT_INTERNAL_API_KEY_CHANGE_ME"
    }
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379,user=default,password=flowchat_redis_pw"
  },
  "RealtimeConnections": {
    "InstanceId": "flowchat-realtime-local",
    "KeyPrefix": "flowchat:realtime",
    "ConnectionTtl": "00:05:00",
    "RefreshInterval": "00:01:00"
  },
  "AllowedHosts": "*"
