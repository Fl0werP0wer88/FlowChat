{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Kafka": {
    "ChatMessageSentConsumer": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "realtime-service",
      "Topic": "dev.flowchat.chat.message.v1",
      "RetryTopic": "dev.flowchat.chat.message.v1.retry",
      "DeadLetterTopic": "dev.flowchat.chat.message.v1.dlq",
      "MaxRetryCount": 5,
      "RetryBaseDelaySeconds": 5,
      "RetryMaxDelaySeconds": 300,
      "AutoOffsetReset": "Earliest"
    },
    "UserPresenceChangedConsumer": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "realtime-service",
      "Topic": "dev.flowchat.user-profile.presence-changed.v1",
      "RetryTopic": "dev.flowchat.user-profile.presence-changed.v1.retry",
      "DeadLetterTopic": "dev.flowchat.user-profile.presence-changed.v1.dlq",
      "MaxRetryCount": 5,
      "RetryBaseDelaySeconds": 5,
      "RetryMaxDelaySeconds": 300,
      "AutoOffsetReset": "Earliest"
    }
  },
  "RealtimeApi": {
    "BaseUrl": "http://localhost:5215",
    "ApiKey": "FLOWCHAT_DEVELOPMENT_INTERNAL_API_KEY_CHANGE_ME"
  },
  "OpenTelemetry": {
    "ServiceName": "FlowChat.RealtimeService.Worker",
    "Otlp": {
      "Endpoint": "http://localhost:4317",
      "Protocol": "Grpc"
    }
  }
}
