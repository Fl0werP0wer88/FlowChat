{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Kafka": {
    "ChatMessageV2Consumer": {
      "BootstrapServers": "",
      "GroupId": "realtime-service",
      "RetryGroupId": "realtime-service-retry",
      "Topic": "dev.flowchat.chat.message.v2",
      "RetryTopic": "dev.flowchat.chat.message.v2.realtime-service.retry",
      "DeadLetterTopic": "dev.flowchat.chat.message.v2.realtime-service.dlq",
      "MaxRetryCount": 5,
      "RetryBaseDelaySeconds": 5,
      "RetryMaxDelaySeconds": 300,
      "AutoOffsetReset": "Earliest"
    },
    "PresenceStatusChangedConsumer": {
      "BootstrapServers": "",
      "GroupId": "realtime-service",
      "RetryGroupId": "realtime-service-retry",
      "Topic": "dev.flowchat.presence.presence",
      "RetryTopic": "dev.flowchat.presence.presence.realtime-service.retry",
      "DeadLetterTopic": "dev.flowchat.presence.presence.realtime-service.dlq",
      "MaxRetryCount": 5,
      "RetryBaseDelaySeconds": 5,
      "RetryMaxDelaySeconds": 300,
      "AutoOffsetReset": "Earliest"
    },
    "ConversationV2ProjectionConsumer": {
      "BootstrapServers": "",
      "GroupId": "realtime-service",
      "RetryGroupId": "realtime-service-retry",
      "Topic": "dev.flowchat.chat.conversation-projection.v2",
      "RetryTopic": "dev.flowchat.chat.conversation-projection.v2.realtime-service.retry",
      "DeadLetterTopic": "dev.flowchat.chat.conversation-projection.v2.realtime-service.dlq",
      "MaxRetryCount": 5,
      "RetryBaseDelaySeconds": 5,
      "RetryMaxDelaySeconds": 300,
      "AutoOffsetReset": "Earliest"
    },
    "ConversationMembershipV2ProjectionConsumer": {
      "BootstrapServers": "",
      "GroupId": "realtime-service",
      "RetryGroupId": "realtime-service-retry",
      "Topic": "dev.flowchat.chat.conversation-membership-projection.v2",
      "RetryTopic": "dev.flowchat.chat.conversation-membership-projection.v2.realtime-service.retry",
      "DeadLetterTopic": "dev.flowchat.chat.conversation-membership-projection.v2.realtime-service.dlq",
      "MaxRetryCount": 5,
      "RetryBaseDelaySeconds": 5,
      "RetryMaxDelaySeconds": 300,
      "AutoOffsetReset": "Earliest"
    }
  },
  "FlowChat": {
    "InternalApi": {
      "ApiKey": "FLOWCHAT_DEVELOPMENT_INTERNAL_API_KEY_CHANGE_ME"
    }
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379,user=default,password=flowchat_redis_pw",
    "RealtimeDb": "Host=localhost;Port=5432;Database=flowchat_realtime_db;Username=flowchat_app;Password=flowchat_app_pw;"
  },
  "RealtimeConnections": {
    "InstanceId": "flowchat-realtime-consumers",
    "KeyPrefix": "flowchat:realtime",
    "ConnectionTtl": "00:01:00",
    "RefreshInterval": "00:00:30"
  },
  "RealtimeApi": {
    "Instances": {
      "flowchat-realtime-local": "http://localhost:5215"
    }
  }
}
