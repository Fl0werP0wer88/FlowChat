{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "RealtimeDb": ""
  },
  "OutboxPublisher": {
    "BatchSize": 500,
    "PollInterval": "00:00:00.500",
    "InitialRetryDelay": "00:00:03",
    "MaxRetryDelay": "00:02:00"
  },
  "Kafka": {
    "RetryOutboxPublisher": {
      "BootstrapServers": "",
      "Topics": [
        "dev.flowchat.chat.message.v2.realtime-service.retry.5s",
        "dev.flowchat.chat.message.v2.realtime-service.retry.60s",
        "dev.flowchat.chat.message.v2.realtime-service.dlq",
        "dev.flowchat.presence.presence.realtime-service.retry.5s",
        "dev.flowchat.presence.presence.realtime-service.retry.60s",
        "dev.flowchat.presence.presence.realtime-service.dlq",
        "dev.flowchat.chat.conversation-projection.v2.realtime-service.retry.5s",
        "dev.flowchat.chat.conversation-projection.v2.realtime-service.retry.60s",
        "dev.flowchat.chat.conversation-projection.v2.realtime-service.dlq",
        "dev.flowchat.chat.conversation-membership-projection.v2.realtime-service.retry.5s",
        "dev.flowchat.chat.conversation-membership-projection.v2.realtime-service.retry.60s",
        "dev.flowchat.chat.conversation-membership-projection.v2.realtime-service.dlq"
      ]
    }
  },
  "OpenTelemetry": {
    "ServiceName": "FlowChat.RealtimeService.OutboxPublisher"
  }
}
