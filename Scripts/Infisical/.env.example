# Local development example for the Infisical bootstrap script
# The bootstrap creates a real .env automatically on first run with generated secrets

INFISICAL_PORT=18180
ENCRYPTION_KEY=generate-16-byte-hex
AUTH_SECRET=generate-32-byte-base64
POSTGRES_USER=infisical
POSTGRES_PASSWORD=generate-url-safe-password
POSTGRES_DB=infisical
DB_CONNECTION_URI=postgres://infisical:generate-url-safe-password@db:5432/infisical
REDIS_URL=redis://redis:6379
SITE_URL=http://localhost:18180
HTTPS_ENABLED=false
