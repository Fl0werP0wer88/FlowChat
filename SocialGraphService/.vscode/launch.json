{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SocialGraphService API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build: SocialGraphService API",
      "program": "${workspaceFolder}/src/FlowChat.SocialGraphService.API/bin/Debug/net10.0/FlowChat.SocialGraphService.API.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/FlowChat.SocialGraphService.API",
      "stopAtEntry": false,
      "console": "internalConsole",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
