{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "Key": "FLOWCHAT_DEVELOPMENT_JWT_KEY_CHANGE_ME_123456789",
    "Issuer": "https://localhost:7236/",
    "Audience": "FlowChat.Client",
    "ExpiresMinutes": 60
  },
  "FlowChat": {
    "InternalApi": {
      "ApiKey": "dev-socialgraph-internal-key"
    }
  },
  "Kafka": {
    "ContactAddedProducer": {
      "BootstrapServers": "localhost:9092",
      "Topic": "dev.flowchat.social-graph.contact"
    },
    "ContactDeletedProducer": {
      "BootstrapServers": "localhost:9092",
      "Topic": "dev.flowchat.social-graph.contact"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "FlowChat.SocialGraphService.API",
    "Otlp": {
      "Endpoint": "http://localhost:4317",
      "Protocol": "Grpc"
    }
  },
  "ConnectionStrings": {
     "SocialGraphDb": "Host=localhost;Port=5432;Database=flowchat_socialgraph_db;Username=flowchat_app;Password=flowchat_app_pw;"
  }
}
