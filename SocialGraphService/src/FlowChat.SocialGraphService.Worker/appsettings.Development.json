{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "SocialGraphDb": "Host=localhost;Port=5432;Database=flowchat_socialgraph_db;Username=flowchat_app;Password=flowchat_app_pw;"
  },
  "Kafka": {
    "UserCreatedConsumer": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "socialgraph-service",
      "Topic": "dev.flowchat.identity.user.v1",
      "RetryTopic": "dev.flowchat.identity.user.v1.retry",
      "DeadLetterTopic": "dev.flowchat.identity.user.v1.dlq",
      "MaxRetryCount": 5,
      "RetryBaseDelaySeconds": 5,
      "RetryMaxDelaySeconds": 300,
      "AutoOffsetReset": "Earliest"
    },
    "UserProfileConsumer": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "socialgraph-service",
      "Topic": "dev.flowchat.user-profile.user-profile.v1",
      "RetryTopic": "dev.flowchat.user-profile.user-profile.v1.retry",
      "DeadLetterTopic": "dev.flowchat.user-profile.user-profile.v1.dlq",
      "MaxRetryCount": 5,
      "RetryBaseDelaySeconds": 5,
      "RetryMaxDelaySeconds": 300,
      "AutoOffsetReset": "Earliest"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "FlowChat.SocialGraphService.Worker",
    "Otlp": {
      "Endpoint": "http://localhost:4317",
      "Protocol": "Grpc"
    }
  }
}

