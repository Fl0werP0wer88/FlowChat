{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "SocialGraphApi": {
    "BaseUrl": "https://localhost:7194",
    "ApiKey": "dev-socialgraph-internal-key"
  },
  "Kafka": {
    "UserProfileConsumer": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "socialgraph-service",
      "RetryGroupId": "socialgraph-service-retry",
      "Topic": "dev.flowchat.user-profile.user-profile.v1",
      "RetryTopic": "dev.flowchat.user-profile.user-profile.v1.socialgraph-service.retry",
      "DeadLetterTopic": "dev.flowchat.user-profile.user-profile.v1.socialgraph-service.dlq",
      "MaxRetryCount": 5,
      "RetryBaseDelaySeconds": 5,
      "RetryMaxDelaySeconds": 300,
      "AutoOffsetReset": "Earliest",
      "BatchSize": 100,
      "BatchMaxWaitTimeMilliseconds": 1000
    }
  },
  "OpenTelemetry": {
    "ServiceName": "FlowChat.SocialGraphService.Consumers",
    "Otlp": {
      "Endpoint": "http://localhost:4317",
      "Protocol": "Grpc"
    }
  }
}
