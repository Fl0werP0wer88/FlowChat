{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "SocialGraphApi": {
    "BaseUrl": "https://localhost:7194",
    "ApiKey": ""
  },
  "Kafka": {
    "UserProfileConsumer": {
      "BootstrapServers": "",
      "GroupId": "socialgraph-service",
      "Topic": "dev.flowchat.user-profile.user-profile.v1",
