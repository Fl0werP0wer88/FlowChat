{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "SocialGraphDb": ""
  },
  "OutboxPublisher": {
    "BatchSize": 25,
    "PollIntervalSeconds": 3,
    "RetryBaseDelaySeconds": 3,
    "MaxRetryDelaySeconds": 120
  },
  "Kafka": {
    "ContactProjectionProducer": {
      "BootstrapServers": "",
      "Topic": "dev.flowchat.social-graph.contact-projection.v1"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "FlowChat.SocialGraphService.OutboxPublisher"
  }
}
