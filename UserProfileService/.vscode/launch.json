{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "UserProfileService API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build: UserProfileService API",
      "program": "${workspaceFolder}/src/FlowChat.UserProfileService.API/bin/Debug/net10.0/FlowChat.UserProfileService.API.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/FlowChat.UserProfileService.API",
      "stopAtEntry": false,
      "console": "internalConsole",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "UserProfileService Worker",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build: UserProfileService Worker",
      "program": "${workspaceFolder}/src/FlowChat.UserProfileService.Worker/bin/Debug/net10.0/FlowChat.UserProfileService.Worker.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/FlowChat.UserProfileService.Worker",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    }
  ],
  "compounds": [
    {
      "name": "UserProfileService",
      "configurations": [
        "UserProfileService API",
        "UserProfileService Worker"
      ],
      "stopAll": true
    }
  ]
}
