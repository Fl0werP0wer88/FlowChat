{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Kafka": {
    "UserEmailConfirmedProducer": {
      "BootstrapServers": "localhost:9092",
      "Topic": "dev.flowchat.user-profile.user-profile.v1"
    },
    "UserEmailVerificationRequestedProducer": {
      "BootstrapServers": "localhost:9092",
      "Topic": "dev.flowchat.notification.email.v1"
    },
    "UserProfileProjectionProducer": {
      "BootstrapServers": "localhost:9092",
      "Topic": "dev.flowchat.user-profile.user-profile.v1"
    }
  },
  "ConfirmationLinks": {
    "EmailVerificationBaseUrl": "http://localhost:5173/email-verification"
  },
  "JwtSettings": {
    "Key": "FLOWCHAT_DEVELOPMENT_JWT_KEY_CHANGE_ME_123456789",
    "Issuer": "https://localhost:7236/",
    "Audience": "FlowChat.Client",
    "ExpiresMinutes": 60
  },
  "FlowChat": {
    "InternalApi": {
      "ApiKey": "dev-userprofile-internal-key"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "FlowChat.UserProfileService.API",
    "Otlp": {
      "Endpoint": "http://localhost:4317",
      "Protocol": "Grpc"
    }
  },
  "ConnectionStrings": {
     "UserProfileDb": "Host=localhost;Port=5432;Database=flowchat_userprofile_db;Username=flowchat_app;Password=flowchat_app_pw;"
  }
}
