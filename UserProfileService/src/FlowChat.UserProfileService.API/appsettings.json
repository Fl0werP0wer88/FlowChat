{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "JwtSettings": {
    "Key": "FLOWCHAT_DEVELOPMENT_JWT_KEY_CHANGE_ME_123456789",
    "Issuer": "https://localhost:7236/",
    "Audience": "FlowChat.Client",
    "ExpiresMinutes": 60
  },
  "Kafka": {
    "UserEmailConfirmedProducer": {
      "BootstrapServers": "localhost:9092",
      "Topic": "dev.flowchat.user-profile.user-profile.v1"
    },
    "UserEmailVerificationRequestedProducer": {
      "BootstrapServers": "localhost:9092",
      "Topic": "dev.flowchat.notification.email.v1"
    },
    "UserProfileProjectionProducer": {
      "BootstrapServers": "localhost:9092",
      "Topic": "dev.flowchat.user-profile.user-profile-projection.v1"
    }
  },
  "ConfirmationLinks": {
    "EmailVerificationBaseUrl": ""
  },
  "AllowedHosts": "*"
}
