{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Kafka": {
    "AccountRegisteredConsumer": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "userprofile-service",
      "RetryGroupId": "userprofile-service-retry",
      "Topic": "dev.flowchat.identity.user.v1",
      "RetryTopic": "dev.flowchat.identity.user.v1.userprofile-service.retry",
      "DeadLetterTopic": "dev.flowchat.identity.user.v1.userprofile-service.dlq",
      "MaxRetryCount": 5,
      "RetryBaseDelaySeconds": 5,
      "RetryMaxDelaySeconds": 300,
      "AutoOffsetReset": "Earliest"
    },
    "UserEmailVerificationRequestedProducer": {
      "BootstrapServers": "localhost:9092",
      "Topic": "dev.flowchat.notification.email.v1"
    }
  },
  "ConnectionStrings": {
    "UserProfileDb": "Host=localhost;Port=5432;Database=flowchat_userprofile_db;Username=flowchat_app;Password=flowchat_app_pw;"
  },
  "ConfirmationLinks": {
    "EmailVerificationBaseUrl": "http://localhost:5173/email-verification"
  },
  "OpenTelemetry": {
    "ServiceName": "FlowChat.UserProfileService.Consumers",
    "Otlp": {
      "Endpoint": "http://localhost:4317",
      "Protocol": "Grpc"
    }
  }
}
