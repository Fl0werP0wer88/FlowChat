{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Kafka": {
    "AccountRegisteredConsumer": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "userprofile-service",
      "RetryGroupId": "userprofile-service-retry",
      "Topic": "dev.flowchat.identity.user.v1",
      "DeadLetterTopic": "dev.flowchat.identity.user.v1.userprofile-service.dlq",
      "RetryTiers": [
        {
          "Topic": "dev.flowchat.identity.user.v1.userprofile-service.retry.5s",
          "Delay": "00:00:05"
        },
        {
          "Topic": "dev.flowchat.identity.user.v1.userprofile-service.retry.60s",
          "Delay": "00:01:00"
        }
      ],
      "AutoOffsetReset": "Earliest"
    },
    "UserEmailVerificationRequestedProducer": {
      "BootstrapServers": "localhost:9092",
      "Topic": "dev.flowchat.notification.email.v1"
    },
    "UserProfileProjectionProducer": {
      "BootstrapServers": "localhost:9092",
      "Topic": "dev.flowchat.user-profile.user-profile-projection.v1"
    }
  },
  "ConnectionStrings": {
    "UserProfileDb": "Host=localhost;Port=5432;Database=flowchat_userprofile_db;Username=flowchat_app;Password=flowchat_app_pw;"
  },
  "ConfirmationLinks": {
    "EmailVerificationBaseUrl": ""
  },
  "OpenTelemetry": {
    "ServiceName": "FlowChat.UserProfileService.Consumers"
  }
}
