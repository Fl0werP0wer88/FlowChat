{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "UserProfileDb": "Host=localhost;Port=5432;Database=flowchat_userprofile_db;Username=flowchat_app;Password=flowchat_app_pw;"
  },
  "OutboxPublisher": {
    "BatchSize": 25,
    "PollIntervalSeconds": 3,
    "RetryBaseDelaySeconds": 3,
    "MaxRetryDelaySeconds": 120
  },
  "Kafka": {
    "UserProfileCreatedProducer": {
      "BootstrapServers": "localhost:9092",
      "Topic": "dev.flowchat.user-profile.user-profile.v1"
    },
    "UserEmailConfirmedProducer": {
      "BootstrapServers": "localhost:9092",
      "Topic": "dev.flowchat.user-profile.user-profile.v1"
    },
    "UserEmailVerificationRequestedProducer": {
      "BootstrapServers": "localhost:9092",
      "Topic": "dev.flowchat.notification.email.v1"
    },
    "UserProfileStateChangedProducer": {
      "BootstrapServers": "localhost:9092",
      "Topic": "dev.flowchat.user-profile.user-profile.v1"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "FlowChat.UserProfileService.OutboxPublisher",
    "Otlp": {
      "Endpoint": "http://localhost:4317",
      "Protocol": "Grpc"
    }
  }
}
