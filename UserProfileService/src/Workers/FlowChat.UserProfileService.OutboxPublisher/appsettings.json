{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "UserProfileDb": ""
  },
  "OutboxPublisher": {
    "BatchSize": 25,
    "PollIntervalSeconds": 3,
    "RetryBaseDelaySeconds": 3,
    "MaxRetryDelaySeconds": 120
  },
  "Kafka": {
    "UserProfileCreatedProducer": {
      "BootstrapServers": "",
      "Topic": "dev.flowchat.user-profile.user-profile.v1"
    },
    "UserEmailConfirmedProducer": {
      "BootstrapServers": "",
      "Topic": "dev.flowchat.user-profile.user-profile.v1"
    },
    "UserEmailVerificationRequestedProducer": {
      "BootstrapServers": "",
      "Topic": "dev.flowchat.notification.email.v1"
    },
    "UserProfileStateChangedProducer": {
      "BootstrapServers": "",
      "Topic": "dev.flowchat.user-profile.user-profile.v1"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "FlowChat.UserProfileService.OutboxPublisher"
  }
}
